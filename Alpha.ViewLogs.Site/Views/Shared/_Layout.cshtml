@using Alpha.ViewLogs.AppResources;
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="/assets/bundles/site-viewlogs/viewlogs-@(Model.UserLevel.ToLower()).css" />
    <link rel="stylesheet" href="~/assets/bundles/default.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <div id="page-popup" class="modal fade hidden" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog ex-modal" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="icon icon-close close" data-dismiss="modal" aria-label="@Resources.Close"><span aria-hidden="true"></span></button>
                    <h4 class="modal-title" id="result-detail-title"><span class="popup-title"></span></h4>
                </div>
                <div class="modal-body">
                    <iframe frameborder="0" allowtransparency="yes" marginheight="0" marginwidth="0" scrolling="auto"
                            id="popup-iframe"></iframe>
                </div>
            </div>
        </div>
    </div>
    <div class="container-fluid">
        <ul class="nav nav-tabs" role="tablist">
            @foreach (var tab in ViewBag.Tabs)
            {
                var isActive = string.Equals(tab.Id, ViewBag.SelectedTab, StringComparison.OrdinalIgnoreCase);
                var tabId = tab.Id.ToLower();
                <li role="presentation" class="@(isActive ? "active" : "")">
                    <a data-tablink="@tab.HRef" role="tab" aria-controls="@tabId" data-toggle="tab" class="lnk-changetab">@tab.Name</a>
                </li>
            }
        </ul>
        @RenderBody()
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>