@using Alpha.ViewLogs.Site.ViewModels.Login;
@using Alpha.ViewLogs.Site.Helpers.StaticResources;

@model IndexViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.ViewLogLogin;
}
<div class="tab-content">
    <div role="tabpanel" class="tab-pane active" id="@ViewContext.RouteData.Values["controller"].ToString().ToLower()">
        <div class="filter">
            <form class="form-inline" role="form">
                <div class="form-group @(Model.IsAgent? "hide":string.Empty)">
                    <input type="text" id="txt-username" placeholder="@Resources.UsernameOrFirstLastName"
                           value="@(string.IsNullOrWhiteSpace(Model.Username) ? string.Empty : Model.Username)"
                           autocomplete="off" />
                </div>
                <div class="form-group">
                    <label>@Resources.ViewDataInMonth</label>
                    <div id="monthPickerID"><div id="ddlMonth"></div></div>
                </div>
                <div class="form-group submit-box">
                    <input type="button" class="btn-submit" id="btn-submit" value="@Resources.Submit">
                    <span id="icon-loading" class="hide block-icon-small"></span>
                </div>
            </form>
            @if (Model.IsAgent)
            {
                <div class="warning">
                    <span class="txt-red">*</span>
                    <label>@Resources.LoginLogs_Warning</label>
                </div>
            }
        </div>

        <div id="content">
            <table id="DataLog" class="width-100per tblRpt">
                <thead>
                    <tr class="RptHeader">
                        <th>@Resources.LogId</th>
                        <th>@Resources.LogDate</th>
                        <th>@Resources.Username</th>
                        <th>@Resources.Action</th>
                        <th>@Resources.Details</th>
                        <th>@Resources.Domain</th>
                        <th>@Resources.Browser</th>
                        <th>@Resources.Country</th>
                        <th>@Resources.IP</th>
                    </tr>

                </thead>
                <tbody>
                    @if (Model.HasLogs)
                    {
                        foreach (LoginLogItemViewModel logItem in Model.LogItems)
                        {
                            <tr>
                                <td align="center">@logItem.LogId</td>
                                <td align="center">@Html.Raw(logItem.LogDate)</td>
                                <td>@logItem.Username</td>
                                <td>@logItem.ActionName</td>
                                <td>@logItem.Details</td>
                                <td align="center">@logItem.Domain</td>
                                <td>@logItem.Browser</td>
                                <td align="center">@logItem.Country</td>
                                <td>@Html.Raw(logItem.IP)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" align="center">@Resources.NoInfo</td>
                        </tr>
                    }
            </table>
            <div id="pagination" class="@(Model.HasLogs ? " ":"hide" )"></div>
        </div>
    </div>
</div>
@section Scripts
{
    @AssetScripts.Render("/bundles/site-viewlogs/default")
    <script type="text/javascript">
        var viewModel = {
            labelFrom: '@Resources.From',
            labelTo: '@Resources.To',
            noInfo: '@Resources.NoInfo',

            maxReportDate: '@Model.MaxReportDate',
            minReportDate: '@Model.MinReportDate',
            fromDate: '@Model.FromDate',
            toDate: '@Model.ToDate',
            dayInMonth: '@Model.DayInMonth',

            totalRecords: @Model.TotalRecords,
            pageSize: @Model.PageSize,
            pageIndex: @Model.PageIndex,
            actionTypeId: '@Model.ActionTypeId',

            showOldValuesCookieName: '@Model.ShowOldValuesCookieName',
            Page: '@Resources.Page',
            of: '@Resources.of',
            Pager_DisplayItems: '@Resources.Pager_DisplayItems'
        };

    </script>
    <script type="text/javascript" src="@ViewLogsScripts.GetAbsolutePath("~/assets/bundles/login")"></script>
}
