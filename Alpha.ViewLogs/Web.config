<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="CustomerSettingConfiguration" type="Fanex.CustomerSetting.Client40.Configurations.CustomerSettingConfiguration, Fanex.CustomerSetting.Client40" />
    <section name="SecurityCodeSection" type="Fanex.Razorbill.Security.Configurations.SecurityCodeSection, Fanex.Razorbill.Security" />
  </configSections>
  
  <system.web>
    <compilation debug="true" targetFramework="4.6.1" />
    <httpRuntime targetFramework="4.6.1" />

    <authentication mode="Forms">
      <forms loginUrl="/main/_Authorization/SignIn.aspx" defaultUrl="/main/Index.aspx" path="/" name=".AGENTFORMSAUTH" protection="All" />
    </authentication>
    <authorization>
      <deny users="?" />
      <allow users="*" />
    </authorization>

    <sessionState mode="StateServer" timeout="10" />
    <machineKey validationKey="DBD341D2E939399A19F6A977A91447BB784B473FD8EAFC272440BA1BE85289C39F681921F05F8DC08E452A7292F986B311ADADD23C7D3DE0B6A0999E0B4D792C" decryptionKey="A6925D7BFBEAD2B3FF1D5C54F862447209527FD7DD70B043AEB4CEBCB0BBF7E4" validation="SHA1" decryption="AES" />
    
    <httpModules></httpModules>
  </system.web>

  <appSettings>
    <add key="UseLiveDb" value="0"/>
    <add key="ViewLogDebug" value="1"/>
    <add key="Disable151_31" value="0"/>
    <add key="Disable151_41" value="0"/>
    <add key="Disable151_51" value="1"/>
    <add key="Disable152_41" value="1"/>
    <add key="Disable152_51" value="1"/>
    <add key="Disable153_51" value="0"/>
    <add key="ISPOSuperId" value="1533014"/>
    <add key="SpecialSuperId" value="689422"/>
  </appSettings>
  <connectionStrings configSource="ConnectionString.config" />
  
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules>
    </modules>
  </system.webServer>
  
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider2, Fanex.Data" resourcePath="~/Web.Configuration/StoreProcedure" enableWatching="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.18.200.124\private$\entlib" defaultCategory="Alpha-MBC-AF-Loccal" />
  <CustomerSettingConfiguration System="2" ServiceUris="http://10.18.200.124:7577/api" CdnUris="http://10.18.200.124:7576" SecretKey="U6BUFHtVcq5SPQcTl7tHLBG/LF6d5YVRKHrCHD9M+Vw=" CustomCssUrl="~/Areas/CustomerSettingRenovation/Content/DCSCustom.css" />
  <SecurityCodeSection configSource="Web.Configuration\SecurityCode.config" />
</configuration>