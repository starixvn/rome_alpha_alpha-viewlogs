<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="ViewLog.master.cs" Inherits="Alpha.ViewLogs._ViewLog.ViewLog" %>

<%@ Import Namespace="Sunplus.Agent.UI" %>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <title>View log</title>
    <link href="<%= ResolveClientUrl("~/_GlobalResources/Css/Agent.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveClientUrl("~/_GlobalResources/Css/Tab.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveClientUrl("~/_GlobalResources/Css/Table.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveClientUrl("~/_GlobalResources/Css/Paging.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveClientUrl("~/_ViewLog/Resources/ViewLog.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveClientUrl("~/_Components/DateTimeControl/JSCalendar/css/jscal2.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveClientUrl("~/_Components/DateTimeControl/JSCalendar/css/steel/steel.css") %>" rel="stylesheet" type="text/css" />
    <link href="<%= ResolveClientUrl("~/_AccountInfo/Resources/styles.css") %>" rel="stylesheet" type="text/css" />
</head>
<body>
    <form id="form1" runat="server">
    <div id="page_main">
        <div>
            <div id="button_hr">
                <div id="tab_hr">
                    <ul>
                        <% if (this.VisibleMenuItem)
                           {%>
                        <li id="CustomerSetting">
                        <a href="javascript:MenuGoTo('CustomerSetting')"><span>
                            <%= Alpha.ViewLogs.LocalResources.Viewlog.defaultlog%>
                        </span>
                        </a>
                        </li>
                        <li id="Status">
                        <a href="javascript:MenuGoTo('Status')"><span>
                        <%= Alpha.ViewLogs.LocalResources.Viewlog.statuslog%>
                            </span> </a></li>
                        <li id="Credit">
                        <a href="javascript:MenuGoTo('Credit')"><span>
                        <%= Alpha.ViewLogs.LocalResources.Viewlog.creditlog%>
                            
                        </span>
                        </a>
                        </li>
                        <%}%>
                        <li id="Login">
                        <a href="javascript:MenuGoTo('Login')"><span>
                        <%= Alpha.ViewLogs.LocalResources.Viewlog.loginlog%>
                        </span>
                        </a>
                        </li>
                    </ul>
                </div>
            </div>
            <%--Search banner--%>
            <div id="box_header" style="border-top: 0px; padding: 5px 5px 5px 5px;">
                <div class="divUserName">
                    <div class="divSearch" id="divUserName" runat="server">
                        <%= Alpha.ViewLogs.LocalResources.Viewlog.username%>
                        <input maxlength="50" id="txtUserName" name="txtUserName" class="username" type="text" style="width: 150px" title='<%= Alpha.ViewLogs.LocalResources.Lang.enterusername %>' onkeydown='onclickUser("<%= Alpha.ViewLogs.LocalResources.Lang.enterusername %>")' onfocus='onclickUser("<%= Alpha.ViewLogs.LocalResources.Lang.enterusername  %>")' onblur='onblurUser("<%= Alpha.ViewLogs.LocalResources.Lang.enterusername %>")' onkeypress='KeyPress(event)' autocomplete="off" />
                        <span id="RequiredUserName" class="required">*</span>
                    </div>
                    <div class="divLogType" id="ddlLogActionType">
                        <%= Alpha.ViewLogs.LocalResources.Viewlog.viewby%>
                        <asp:DropDownList CssClass="ActionType" onChange="DoSearch();" ID="ddlActionType" runat="server" EnableViewState="false">
                        </asp:DropDownList>
                    </div>
                    <asp:Literal ID="ltrDate" runat="server"></asp:Literal>
                    <div id="divShowOldValue">
                        <input type="checkbox" value="true" id="chk_showOldValue" onchange="setShowOldValueCookie(this)" />
                        <label for="chk_showOldValue"><%= Alpha.ViewLogs.LocalResources.Viewlog.showOldValue %></label>
                    </div>
                </div>
            </div>
            <div class="warning" id="divMessageWarning" style="display: none">
                <ul>
                    <li>
                        <asp:Literal ID="Literal10" Text="<%# Alpha.ViewLogs.LocalResources.Viewlog.login_message_log %>" runat="server"></asp:Literal>
                    </li>
                </ul>
            </div>
            <asp:ContentPlaceHolder ID="contentData" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </div>
    </form>

    <script src="<%= ResolveClientUrl("~/_GlobalResources/Js/Core.js") %>" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/_Components/AGEWnd/AGEWnd.js") %>" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/_AccountInfo/Resources/autocomplete.js") %>" type="text/javascript"></script>
    <script src="<%= ResolveClientUrl("~/_ViewLog/Resources/ViewLogLibs.js") %>" type="text/javascript"></script>

    <script type="text/javascript" language="javascript">
        var ctrInput = "<%=DateTime.Now.ToString()%>";
        var ddlActionType = '<%=ddlActionType.ClientID%>';
        var role = '<%= Sunplus.Agent.Model.Entities.UserSession.Current.RoleId %>';
        var enterusername = '<%=Alpha.ViewLogs.LocalResources.Lang.enterusername%>';
        RegisterStartUp('Initialize()');
    </script>

    <div class="shadow" id="shadow" />
    <div class="output" id="output" />
</body>
</html>
